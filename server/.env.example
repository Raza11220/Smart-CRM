PORT=5000
NODE_ENV=development
# npm run db:dev starts an isolated replica set on 27018. Atlas replica sets also work.
MONGODB_URI=mongodb://127.0.0.1:27018/smartcrm?replicaSet=smartcrm-dev
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Generate two independent values: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-48-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-at-least-48-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SAME_SITE=lax
TRUST_PROXY=0
ALLOW_PUBLIC_REGISTRATION=false
# Explicit development seeding only; choose unique passwords of at least 12 characters.
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
# Tests require a dedicated database name beginning with smartcrm_test_.
TEST_MONGODB_URI=mongodb://127.0.0.1:27018/smartcrm_test_api?replicaSet=smartcrm-dev
